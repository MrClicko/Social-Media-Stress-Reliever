{
  "manifest_version": 2,
  "name": "Social Media Stress Reliever",
  "version": "0.1.0",
  "description": "Adds mindful breaks and hides high-stress social media feed surfaces.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Stress Reliever",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "applications": {
    "gecko": {
      "id": "social-media-stress-reliever@example.com"
    }
  }
}
